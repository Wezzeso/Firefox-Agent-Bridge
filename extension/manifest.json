{
  "manifest_version": 2,
  "name": "Firefox Agent Bridge",
  "version": "1.1.0",
  "description": "Локальное управление разрешёнными вкладками из Codex через Native Messaging.",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-agent-bridge@local.codex",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "webNavigation",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Firefox Agent Bridge",
    "default_popup": "popup.html",
    "default_icon": "icons/bridge.svg"
  },
  "icons": {
    "48": "icons/bridge.svg",
    "96": "icons/bridge.svg"
  },
  "commands": {
    "stop-all": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Остановить управление всеми вкладками"
    }
  },
  "incognito": "not_allowed",
  "content_security_policy": "script-src 'self'; object-src 'none'"
}
